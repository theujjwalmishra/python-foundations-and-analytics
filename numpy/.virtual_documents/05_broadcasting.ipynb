import numpy as np


# Vectorization


arr = np.array ([1,2,4,5])
result = arr ** 3
print(result)


mean = np.mean(arr)
print(mean)


arr_2 = np.array([2,4,14,54])
sum = np.sum(arr + arr_2)
print(sum)


# Broadcasting 


arr[0] = 5 
print(arr) # output = [5 2 4 5]
result = arr + 10 # it means it add 10 in all the elements
result


# Broadcasting with different shapes


arr_3 = np.array([5,64,34,343])


sum = arr + arr_2 + arr_3
print(sum)
